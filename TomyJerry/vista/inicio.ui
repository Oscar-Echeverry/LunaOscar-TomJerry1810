    <widget class="QLabel" name="descripcionInicio">
     <property name="text">
      <string>La plaza está llena de vida… y Tom te sigue.
Reúne seis quesos, encuentra la llave y llega a Llorente.
Pulsa E junto a la puerta para completar el recorrido.</string>
     </property>
