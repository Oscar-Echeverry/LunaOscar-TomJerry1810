  <property name="styleSheet">
   <string notr="true">QWidget { font-family: &quot;Segoe UI&quot;; font-size: 14px; color: #fff4d6; }
QLabel { background: transparent; border: none; }
QPushButton { background-color: #f1ba4c; color: #182631; border: none; border-radius: 9px; padding: 8px 16px; font-weight: 700; }
QPushButton:hover { background-color: #ffd27e; }
QPushButton:pressed { background-color: #dca33e; }
QPushButton[secundario=&quot;true&quot;] { background-color: #304a56; color: #fff4d6; }
QPushButton[secundario=&quot;true&quot;]:hover { background-color: #405e6b; }
QFrame#paginaInicio { background-color: #182631; border: 1px solid #f1ba4c; border-radius: 18px; }
QLabel#tituloInicio { font-size: 28px; font-weight: 700; } QLabel#firmaInicio { color: #f1ba4c; font-size: 12px; font-weight: 700; } QLabel#descripcionInicio { font-size: 16px; }
</string>
